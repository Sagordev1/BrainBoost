# Copy this file to .env and fill in your own values. Never commit the real .env file.

PORT=5000

# MongoDB connection string (MongoDB Atlas or local mongod)
MONGO_URI=mongodb://127.0.0.1:27017/brainboost

# Secret used to sign user JWT auth cookies - use a long random string
JWT_SECRET=change_this_to_a_long_random_string

# Secret used to sign admin JWT auth cookies - use a DIFFERENT long random string
ADMIN_JWT_SECRET=change_this_to_a_different_long_random_string

# Plain-text admin password used ONLY the first time you run scripts/hashAdminPassword.js
# to generate ADMIN_PASSWORD_HASH below. You can delete this line afterwards.
ADMIN_PASSWORD_HASH=$2y$10$replace_with_a_bcrypt_hash_generated_by_the_hash_script

# Origin of the React dev server, for CORS
CLIENT_ORIGIN=http://localhost:5173

# development | production - set to production when deploying (enables secure cookies)
NODE_ENV=development
